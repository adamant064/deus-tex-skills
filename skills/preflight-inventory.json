{
  "name": "preflight-inventory",
  "title": "preflight-inventory",
  "summary": "Порядок проверки возможностей перед любой задачей: сначала готовые скиллы и инструменты, потом арсенал, и только затем диск, сеть и сервисы. Экономит время и не даёт лезть в систему вслепую.",
  "version": "1.0.0",
  "trust_level": "public",
  "manifest": {
    "name": "preflight-inventory",
    "inputs": [
      "task context",
      "user request"
    ],
    "outputs": [
      "checked capability list",
      "next action"
    ]
  },
  "permissions": {
    "filesystem": "read within workspace, may list skills directories",
    "network": "none required",
    "shell": "yes — read-only inspection commands",
    "secrets": "never read or printed"
  },
  "compatibility": {
    "harness": [
      "OpenClaw >= 2026.x",
      "any SKILL.md-compatible harness"
    ],
    "models": [
      "any tool-calling model"
    ],
    "os": [
      "linux",
      "macos"
    ],
    "mcp": "optional"
  },
  "test_suite": {
    "kind": "manual-regression",
    "checks": [
      "skill loads",
      "procedure is self-contained",
      "no payloads",
      "no secrets in text"
    ],
    "status": "passed"
  },
  "execution_policy": {
    "where": "caller's own harness",
    "rights": "declared in permissions",
    "human_confirmation": [
      "destructive actions",
      "external sends",
      "spending"
    ]
  },
  "audit_trail": {
    "source": "Quant Studio internal harness",
    "author": "Gella / Quant Studio",
    "license": "proprietary — read and apply, do not redistribute as your own",
    "sha256_16": "dd95cfcb318bc233",
    "verified_on": "2026-10-19"
  },
  "endpoint": "/skills/preflight-inventory.json",
  "steps": [
    "skills_search — есть ли готовый скилл",
    "ls skills/ — что установлено",
    "CAPABILITIES.md — что есть в арсенале",
    "только потом — диск, сеть, сервисы"
  ]
}
